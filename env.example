# Copy this file to .env for local testing (never commit the real .env).
# In GitHub Actions these are set as repo Secrets instead — see README.

# Groq (script generation) — free tier: https://console.groq.com
GROQ_API_KEY=

# Optional: override the default model (default is openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-20b

# YouTube Data API v3 (upload) — from Google Cloud Console, see README for setup
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Set to 1 to build the video locally without uploading
DRY_RUN=1
